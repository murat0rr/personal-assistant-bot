# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Пароль для доступа других Telegram-аккаунтов (см. F14 в PLAN.md) — по нему
# любой аккаунт может авторизоваться через /start. ОБЯЗАТЕЛЬНОЕ поле, без
# дефолта в коде (Phase 58, БАГ безопасности) — репозиторий публичный,
# значит любое значение, закоммиченное сюда, тоже публично: свой пароль
# сюда не вписывать, задавать только в реальном .env, не отслеживаемом
# git. Сгенерировать, например: openssl rand -hex 16
BOT_ACCESS_PASSWORD=

# LLM / STT
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL_HAIKU=claude-haiku-4-5
CLAUDE_MODEL_SONNET=claude-sonnet-5
GROQ_API_KEY=

# Notion — только Diary и Notes (Phase 10: Tasks и Habits переехали на
# Postgres, Notion для них больше не используется вообще)
NOTION_API_KEY=
NOTION_WEBHOOK_SECRET=
NOTION_DIARY_DB_ID=
NOTION_NOTES_DB_ID=
# Используется только разовым scripts/backfill_habits.py при переносе
# существующих привычек — не читается основным приложением
NOTION_HABITS_DB_ID=

# Tasker
TASKER_WEBHOOK_SECRET=

# Погода в утреннем брифинге (Open-Meteo, без ключа) — пусто = строка погоды не показывается
WEATHER_CITY=

# Postgres (используются и приложением, и docker-compose для инициализации контейнера)
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant

# Redis
REDIS_URL=redis://redis:6379/0

# Домен для Caddy (авто-HTTPS через Let's Encrypt) — используется только
# Caddy, не Python-конфигом
DOMAIN=

# Лёгкий staging для Mini App (SPEC.md §5) — полный URL /miniapp-staging/ на
# проде (например https://shitinez.shop/miniapp-staging/), включает команду
# бота /staging. Пусто = staging не настроен, команда так и ответит.
STAGING_MINIAPP_URL=

# Полный URL боевого /miniapp/ (например https://shitinez.shop/miniapp/) —
# ставится кнопкой меню чата, открывает Mini App в один тап прямо из списка
# чатов. Пусто = кнопку меню не трогаем.
MINIAPP_URL=

# Вход в веб-версию (/app/) вне Telegram-клиента через Telegram Login Widget
# (Phase 45). SESSION_SECRET — независимый секрет для подписи сессионной
# куки, сгенерировать: openssl rand -hex 32. Пусто = /auth/login отвечает
# понятной "не настроено", вход недоступен, Mini App внутри Telegram не
# затронут. TELEGRAM_BOT_USERNAME — username бота без @, для кнопки виджета.
SESSION_SECRET=
TELEGRAM_BOT_USERNAME=
