# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Пароль для доступа других Telegram-аккаунтов (см. F14 в PLAN.md) — по нему
# любой аккаунт может авторизоваться через /start
BOT_ACCESS_PASSWORD=это читинец

# LLM / STT
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL_HAIKU=claude-haiku-4-5
CLAUDE_MODEL_SONNET=claude-sonnet-5
GROQ_API_KEY=

# Notion — только Diary и Notes (Phase 10: Tasks и Habits переехали на
# Postgres, Notion для них больше не используется вообще)
NOTION_API_KEY=
NOTION_WEBHOOK_SECRET=
NOTION_DIARY_DB_ID=
NOTION_NOTES_DB_ID=
# Используется только разовым scripts/backfill_habits.py при переносе
# существующих привычек — не читается основным приложением
NOTION_HABITS_DB_ID=

# Tasker
TASKER_WEBHOOK_SECRET=

# Погода в утреннем брифинге (Open-Meteo, без ключа) — пусто = строка погоды не показывается
WEATHER_CITY=

# Postgres (используются и приложением, и docker-compose для инициализации контейнера)
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant

# Redis
REDIS_URL=redis://redis:6379/0

# Домен для Caddy (авто-HTTPS через Let's Encrypt) — используется только
# Caddy, не Python-конфигом
DOMAIN=
